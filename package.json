{
  "name": "cmd-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 本地多终端管理工具：项目化命令 + 一键启动",
  "main": "out/main/index.js",
  "build": {
    "appId": "com.cmdwindows.app",
    "productName": "CmdWindows",
    "defaultArch": "x64",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "electronLanguages": ["zh-CN", "en-US"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && electron-vite build",
    "package:win": "electron-vite build && electron-builder --win",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package.ps1",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-vue": "^8.5.1",
    "node-pty": "^1.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.3.13"
  }
}
